{
  "name": "xiaobu-frontend",
  "private": true,
  "scripts": {
    "format:check": "cd .. && prettier --check --config frontend/.prettierrc.json --ignore-path frontend/.prettierignore \"{frontend,docs/ui-design/vant-pilot}/**/*.{vue,js,cjs,mjs,ts,css,scss,html,json}\"",
    "format:write": "cd .. && prettier --write --config frontend/.prettierrc.json --ignore-path frontend/.prettierignore \"{frontend,docs/ui-design/vant-pilot}/**/*.{vue,js,cjs,mjs,ts,css,scss,html,json}\"",
    "dev:h5": "uni",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-weixin:preview": "node ../scripts/build-wechat-preview.mjs",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@dcloudio/types": "3.4.31",
    "vite": "5.2.8",
    "typescript": "4.9.5"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-h5": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030420261029002",
    "vue": "3.4.21",
    "vant": "4.9.6"
  }
}
